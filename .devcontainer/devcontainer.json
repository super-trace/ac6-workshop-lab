{
	"name": "AC6 workshop lab (SR Linux + Arista cEOS)",
	"build": { "dockerfile": "Dockerfile" },
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/sshd:1": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"hostRequirements": {
		"cpus": 4,
		"memory": "16gb"
	},
	"privileged": true,
	"forwardPorts": [2401, 2402, 8000, 8001],
	"portsAttributes": {
		"8000": { "label": "NetBox", "onAutoForward": "silent" },
		"8001": { "label": "NetBox MCP", "onAutoForward": "silent" },
		"2401": { "label": "nokia SSH" },
		"2402": { "label": "arista SSH" }
	},
	"onCreateCommand": "bash .devcontainer/on-create.sh && bash .devcontainer/setup.sh",
	"postCreateCommand": "AC6_CEOS_OPTIONAL=1 just ceos-pull"
}
