{
	"name": "AC6 workshop lab (SR Linux + FRRouting)",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest"
		}
	},
	"privileged": true,
	"forwardPorts": [2401, 2402, 2403, 2404, 2405, 2406, 2407, 2408],
	"portsAttributes": {
		"2401": { "label": "spine-jfk SSH" },
		"2402": { "label": "leaf-jfk SSH" },
		"2403": { "label": "client-jfk SSH" },
		"2404": { "label": "spine-iad SSH" },
		"2405": { "label": "leaf-iad SSH" },
		"2406": { "label": "client-iad SSH" },
		"2407": { "label": "rtr-phl SSH" },
		"2408": { "label": "rtr-ewr SSH" }
	},
	"postCreateCommand": "bash .devcontainer/setup.sh"
}
