{
	"name": "AC6 workshop lab (SR Linux + Arista cEOS)",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/sshd:1": {
			"version": "latest"
		}
	},
	"hostRequirements": {
		"cpus": 4,
		"memory": "16gb"
	},
	"privileged": true,
	"forwardPorts": [2401, 2402, 2403, 2404, 2405, 2406, 8000],
	"portsAttributes": {
		"8000": { "label": "NetBox", "onAutoForward": "silent" },
		"2401": { "label": "sw-jfk SSH" },
		"2402": { "label": "client-jfk SSH" },
		"2403": { "label": "sw-iad SSH" },
		"2404": { "label": "client-iad SSH" },
		"2405": { "label": "rtr-phl SSH" },
		"2406": { "label": "rtr-ewr SSH" }
	},
	"onCreateCommand": "bash .devcontainer/on-create.sh",
	"postCreateCommand": "bash .devcontainer/setup.sh"
}
