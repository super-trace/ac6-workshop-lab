# Settings for the workshop's NetBox container (see compose.yml). Every
# secret here is a fixed, public value: like the shared SSH key, it's only
# for a disposable lab, so never reuse one on a NetBox that matters.
DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=ac6-workshop-db
REDIS_HOST=redis
REDIS_DATABASE=0
REDIS_PASSWORD=ac6-workshop-redis
REDIS_CACHE_HOST=redis
REDIS_CACHE_DATABASE=1
REDIS_CACHE_PASSWORD=ac6-workshop-redis
SECRET_KEY=8smZs2ZbdXOU0N9P4Kk5so8pmg9kTdsdWOfLiIMvJUqqV4HKva
# NetBox requires at least 50 characters.
API_TOKEN_PEPPER_1=ac6-workshop-netbox-api-token-pepper-not-a-secret-0000
CORS_ORIGIN_ALLOW_ALL=True
# One web worker (~300 MB) instead of the image's four (~1.2 GB): plenty for
# the handful of people using one Codespace's NetBox.
GRANIAN_WORKERS=1
METRICS_ENABLED=false
# The image creates this admin, and its API token, on first start. The
# token is sent as "Authorization: Bearer nbt_<key>.<token>".
SKIP_SUPERUSER=false
SUPERUSER_NAME=oldprotocol
SUPERUSER_EMAIL=oldprotocol@example.com
SUPERUSER_PASSWORD=newbrain
SUPERUSER_API_KEY=ac6workshop0
SUPERUSER_API_TOKEN=ac6workshopnetboxapitoken000000000000000
