{#
  SR Linux baseline: the config NetBox says a router on the "Nokia SR Linux"
  platform should run, as SR Linux flat set commands. Everything comes from
  NetBox's own data; there are no config context variables.

  - Interfaces, descriptions, addresses and VLANs come from the device's
    NetBox interfaces. An address on a physical port or loopback goes on its
    subinterface 0; a child interface named <port>.<n> is subinterface <n>,
    tagged with its untagged VLAN.
  - BGP needs the device's "BGP AS" custom field (bgp_asn):
    - Neighbors come from cables: for each cabled port with an address, the
      device at the other end, its address in the same subnet, and that
      device's BGP AS. A far end without a BGP AS gets no neighbor.
    - The router ID is the device's address with role "loopback" (or, with
      none, lo0's).
    - The device advertises the networks on its loopbacks (lo0, lo1, ...).
  - Management interfaces are left out; the lab manages them.

  Seeded by scripts/netbox-seed.sh from lab/netbox/templates/.
#}
{% set routed = [] %}
{% for iface in device.interfaces.all() if not iface.mgmt_only and not iface.parent and iface.name not in ('mgmt0', 'eth0') %}
{% if iface.type != 'virtual' %}
set / interface {{ iface.name }} admin-state enable
{% endif %}
{% if iface.description %}
set / interface {{ iface.name }} description "{{ iface.description }}"
{% endif %}
{% if iface.mode == 'tagged' %}
set / interface {{ iface.name }} vlan-tagging true
{% endif %}
{% for ip in iface.ip_addresses.all() %}
{% if loop.first %}
set / interface {{ iface.name }} subinterface 0 ipv4 admin-state enable
{% if routed.append(iface.name ~ '.0') %}{% endif %}
{% endif %}
set / interface {{ iface.name }} subinterface 0 ipv4 address {{ ip.address }}
{% endfor %}
{% for sub in iface.child_interfaces.all() %}
{% set index = sub.name.split('.')[-1] %}
{% if sub.description %}
set / interface {{ iface.name }} subinterface {{ index }} description "{{ sub.description }}"
{% endif %}
{% if sub.untagged_vlan %}
set / interface {{ iface.name }} subinterface {{ index }} vlan encap single-tagged vlan-id {{ sub.untagged_vlan.vid }}
{% endif %}
{% for ip in sub.ip_addresses.all() %}
{% if loop.first %}
set / interface {{ iface.name }} subinterface {{ index }} ipv4 admin-state enable
{% if routed.append(sub.name) %}{% endif %}
{% endif %}
set / interface {{ iface.name }} subinterface {{ index }} ipv4 address {{ ip.address }}
{% endfor %}
{% endfor %}

{% endfor %}
set / network-instance default type default
set / network-instance default admin-state enable
{% for name in routed %}
set / network-instance default interface {{ name }}
{% endfor %}
{% set asn = device.cf.get('bgp_asn') %}
{% if asn %}
{# What BGP needs, gathered from interfaces, addresses and cables. #}
{% set by_role = [] %}
{% set by_name = [] %}
{% set advertise = [] %}
{% set neighbors = [] %}
{% for iface in device.interfaces.all() if not iface.mgmt_only and iface.name not in ('mgmt0', 'eth0') %}
{% for ip in iface.ip_addresses.all() %}
{% if ip.role == 'loopback' and by_role.append(ip.address.ip) %}{% endif %}
{% if iface.name.startswith('lo') and iface.type == 'virtual' %}
{% if iface.name == 'lo0' and by_name.append(ip.address.ip) %}{% endif %}
{% if advertise.append(ip.address.cidr) %}{% endif %}
{% endif %}
{% if iface.cable %}
{% for far in iface.link_peers if far.device is defined and far.device.cf.get('bgp_asn') %}
{% for theirs in far.ip_addresses.all() if theirs.address.ip in ip.address and theirs.address.ip != ip.address.ip %}
{% if neighbors.append({'ip': theirs.address.ip, 'asn': far.device.cf.get('bgp_asn')}) %}{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
{% set router_ids = by_role or by_name %}

{% for prefix in advertise %}
set / routing-policy prefix-set LOCAL prefix {{ prefix }} mask-length-range exact
{% endfor %}
set / routing-policy policy EXPORT-LOCAL default-action policy-result reject
set / routing-policy policy EXPORT-LOCAL statement 10 match prefix prefix-set LOCAL
set / routing-policy policy EXPORT-LOCAL statement 10 action policy-result accept
set / routing-policy policy IMPORT-ALL default-action policy-result accept

set / network-instance default protocols bgp admin-state enable
set / network-instance default protocols bgp autonomous-system {{ asn }}
{% if router_ids %}
set / network-instance default protocols bgp router-id {{ router_ids[0] }}
{% endif %}
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
{% if neighbors %}
{# One group, PEER, takes the first neighbor's AS; a neighbor in another AS overrides it. #}
{% set group_as = neighbors[0].asn %}
set / network-instance default protocols bgp group PEER peer-as {{ group_as }}
set / network-instance default protocols bgp group PEER description "eBGP peer AS{{ group_as }}"
set / network-instance default protocols bgp group PEER export-policy [EXPORT-LOCAL]
set / network-instance default protocols bgp group PEER import-policy [IMPORT-ALL]
{% for peer in neighbors %}
set / network-instance default protocols bgp neighbor {{ peer.ip }} peer-group PEER
{% if peer.asn != group_as %}
set / network-instance default protocols bgp neighbor {{ peer.ip }} peer-as {{ peer.asn }}
{% endif %}
set / network-instance default protocols bgp neighbor {{ peer.ip }} description "eBGP peer"
{% endfor %}
{% endif %}
{% endif %}
