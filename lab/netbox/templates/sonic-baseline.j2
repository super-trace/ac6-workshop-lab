{#
  SONiC baseline: the config NetBox says a switch on the "SONiC" platform
  should run, as SONiC `config` commands followed by FRR configuration for
  vtysh. Everything comes from NetBox's own data; there are no config
  context variables. SONiC has no `config` command for a port's
  description, so that goes straight into CONFIG_DB.

  - Interfaces, descriptions, addresses and VLANs come from the device's
    NetBox interfaces: an Ethernet port in tagged mode creates and carries
    its tagged VLANs, a LoopbackN interface is created, and every address
    goes on its interface (a VLAN's gateway on VlanN). SONiC describes
    physical ports only.
  - BGP needs the device's "BGP AS" custom field (bgp_asn):
    - Neighbors come from cables: for each cabled port with an address, the
      device at the other end, its address in the same subnet, and that
      device's BGP AS. A far end without a BGP AS gets no neighbor.
    - The router ID is the device's address with role "loopback" (or, with
      none, Loopback0's).
    - The switch advertises the networks on its LoopbackN interfaces.
  - Management interfaces are left out; the lab manages them.

  Seeded by scripts/netbox-seed.sh from lab/netbox/templates/.
#}
{% for iface in device.interfaces.all() if not iface.mgmt_only and iface.name not in ('eth0', 'mgmt0') %}
{% if iface.name.startswith('Loopback') %}
config loopback add {{ iface.name }}
{% endif %}
{% if iface.description and iface.name.startswith('Ethernet') %}
sonic-db-cli CONFIG_DB HSET "PORT|{{ iface.name }}" description "{{ iface.description }}"
{% endif %}
{% if iface.mode == 'tagged' %}
{% for vlan in iface.tagged_vlans.all() %}
config vlan add {{ vlan.vid }}
config vlan member add {{ vlan.vid }} {{ iface.name }}
{% endfor %}
{% endif %}
{% for ip in iface.ip_addresses.all() %}
config interface ip add {{ iface.name }} {{ ip.address }}
{% endfor %}
{% endfor %}
{% set asn = device.cf.get('bgp_asn') %}
{% if asn %}
{# What BGP needs, gathered from interfaces, addresses and cables. #}
{% set by_role = [] %}
{% set by_name = [] %}
{% set advertise = [] %}
{% set neighbors = [] %}
{% for iface in device.interfaces.all() if not iface.mgmt_only and iface.name not in ('mgmt0', 'eth0') %}
{% for ip in iface.ip_addresses.all() %}
{% if ip.role == 'loopback' and by_role.append(ip.address.ip) %}{% endif %}
{% if iface.name.startswith('Loopback') %}
{% if iface.name == 'Loopback0' and by_name.append(ip.address.ip) %}{% endif %}
{% if advertise.append(ip.address.cidr) %}{% endif %}
{% endif %}
{% if iface.cable %}
{% for far in iface.link_peers if far.device is defined and far.device.cf.get('bgp_asn') %}
{% for theirs in far.ip_addresses.all() if theirs.address.ip in ip.address and theirs.address.ip != ip.address.ip %}
{% if neighbors.append({'ip': theirs.address.ip, 'asn': far.device.cf.get('bgp_asn')}) %}{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
{% set router_ids = by_role or by_name %}

! FRR (vtysh)
{% for prefix in advertise %}
ip prefix-list LOCAL seq {{ loop.index * 5 }} permit {{ prefix }}
{% endfor %}
route-map EXPORT-LOCAL permit 10
 match ip address prefix-list LOCAL
exit
route-map IMPORT-ALL permit 10
exit
router bgp {{ asn }}
{% if router_ids %}
 bgp router-id {{ router_ids[0] }}
{% endif %}
{% for peer in neighbors %}
 neighbor {{ peer.ip }} remote-as {{ peer.asn }}
 neighbor {{ peer.ip }} description eBGP peer AS{{ peer.asn }}
{% endfor %}
 address-family ipv4 unicast
{% for prefix in advertise %}
  network {{ prefix }}
{% endfor %}
{% for peer in neighbors %}
  neighbor {{ peer.ip }} route-map IMPORT-ALL in
  neighbor {{ peer.ip }} route-map EXPORT-LOCAL out
{% endfor %}
 exit-address-family
exit
{% endif %}
