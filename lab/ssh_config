# AC6 workshop lab — Include this file from ~/.ssh/config:
#   Include /path/to/workshop/lab/ssh_config
# Then: stcli nokia / stcli arista
#
# Host keys regenerate on every `lab-up` (disposable containers), so strict
# host-key checking would fail every redeploy for no security benefit here —
# these are loopback-only lab nodes. A dedicated known_hosts file (wiped by
# `just lab-up`/`lab-down`) rather than /dev/null: stcli's trust-on-first-use
# flow writes the accepted key back and re-verifies against it, so /dev/null
# would make every "trust this host key?" prompt loop forever.
#
# Both nodes log in as `stcli` with the shared, non-secret lab key (`admin`
# is a reserved username on SR Linux and can't take an ssh-key). `just
# lab-setup` copies the key to ~/.ssh/ac6-workshop-key.
Host nokia arista
    StrictHostKeyChecking no
    UserKnownHostsFile ~/.ac6-workshop-known-hosts
    HostName 127.0.0.1
    IdentityFile ~/.ssh/ac6-workshop-key
    User stcli

Host nokia
    Port 2401
Host arista
    Port 2402
